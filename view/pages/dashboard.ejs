<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/style/main.css">
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
        <title>Fisheries | Dashboard</title>
    </head>
    <body>
        <header>
            <h2>Fisheries Dashboard</h2>
            <div class="header-right">
                <span>Welcome, <strong><%= user %></strong></span>
                <nav>
                    <a href="/logout">Logout</a>
                </nav>
            </div>
        </header>

        <div class="dashboard-content">
            <% if (locals.error_msg) { %>
                <p class="error-msg"><%= error_msg %></p>
            <% } %>
            <% if (locals.success_msg) { %>
                <p class="success-msg"><%= success_msg %></p>
            <% } %>

            <!-- KPI Summary Row -->
            <div class="kpi-grid">
                <div class="kpi-card">
                    <span class="kpi-label">Tracked Vessels</span>
                    <h3 id="kpi-vessels">—</h3>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Total Fishing Hours</span>
                    <h3 id="kpi-hours">—</h3>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Top Gear Type</span>
                    <h3 id="kpi-gear">—</h3>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Saved Datasets</span>
                    <h3 id="kpi-pending">—</h3>
                </div>
            </div>

            <!-- Main Dashboard Panels (Ready for API integration) -->
            <div class="dashboard-main">
                <div class="panel map-panel">
                    <div class="panel-header">
                        <h3>Map View</h3>
                        <span id="area-status" class="sync-meta">Select an area and click Load Area on Map</span>
                    </div>
                    <div id="map" style="width: 100%; height: 450px; border-radius: 8px;"></div>
                </div>

                <div class="panel form-panel">
                    <h3>Filter Data by Area</h3>
                    <form id="area-filter-form">
                        <label for="area-preset">Preset Area</label>
                        <select id="area-preset">
                            <option value="56.0,-3.0,60.0,2.0">Scottish Waters / North Sea</option>
                            <option value="50.0,-11.0,55.0,-5.0">Irish & Celtic Sea</option>
                            <option value="49.5,-5.5,51.2,1.5">English Channel</option>
                            <option value="VIEWPORT">Use Current Map Viewport</option>
                        </select>

                        <label>Bounding Box (Min/Max Lat & Lng)</label>
                        <div class="split-inputs">
                            <input type="number" step="any" id="min-lat" value="56.0" placeholder="Min Lat" required>
                            <input type="number" step="any" id="min-lng" value="-3.0" placeholder="Min Lng" required>
                        </div>
                        <div class="split-inputs">
                            <input type="number" step="any" id="max-lat" value="60.0" placeholder="Max Lat" required>
                            <input type="number" step="any" id="max-lng" value="2.0" placeholder="Max Lng" required>
                        </div>

                        <label>Date Range</label>
                        <div class="split-inputs">
                            <input type="date" id="start-date" value="2025-09-01" required>
                            <input type="date" id="end-date" value="2025-09-15" required>
                        </div>

                        <label for="spatial-res">Grid Resolution</label>
                        <select id="spatial-res">
                            <option value="LOW">Low (0.1° Grid Cells)</option>
                            <option value="HIGH">High (0.01° Fine Grid Cells)</option>
                        </select>

                        <button type="submit" class="btn-primary">Load Area on Map</button>
                    </form>
                </div>
            </div>

            <!--vessel search panel -->
            <div class="panel vessel-search-panel">
            <h3>Search vessels</h3>
            <form id="vessel-search-form">
                <label for="vessel-query">Vessel name, IMO, or MMSI</label>
                <input id="vessel-query" name="query" required>
                <button type="submit">Search</button>
            </form>
            <p id="vessel-search-status" role="status"></p>
            <ul id="vessel-results"></ul>
        </div>

            <div class="panel table-panel">
                <div class="panel-header">
                    <h3>Activity Log</h3>


  <button type="button" onclick="downloadCSV()">
            Download CSV
              </button>
                </div>
                <table class="vessel-table">
                    <thead>
                        <tr>
                            <th>Vessel Name</th>
                            <th>MMSI</th>
                            <th>Flag</th>
                            <th>Gear Type</th>
                            <th>Event</th>
                            <th>Hours</th>
                            <th>Coordinates</th>
                        </tr>
                    </thead>
                    <tbody id="vessel-tbody">
                        <tr>
                            <td colspan="7" style="opacity: 0.6;">No data loaded yet.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script src="/scripts/main.js"></script>
    </body>
</html>
