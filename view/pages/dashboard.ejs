<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/style/main.css">
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
        <title>Fisheries | Dashboard</title>
    </head>
    <body>
        <header>
            <h2>Fisheries Dashboard</h2>
            <div class="header-right">
                <span>Welcome, <strong><%= user %></strong></span>
                <nav>
                    <a href="/logout">Logout</a>
                </nav>
            </div>
        </header>

        <div class="dashboard-content">
            <% if (locals.error_msg) { %>
                <p class="error-msg"><%= error_msg %></p>
            <% } %>
            <% if (locals.success_msg) { %>
                <p class="success-msg"><%= success_msg %></p>
            <% } %>

            <!-- KPI Summary Row -->
            <div class="kpi-grid">
                <div class="kpi-card">
                    <span class="kpi-label">Tracked Vessels</span>
                    <h3 id="kpi-vessels">—</h3>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Total Fishing Hours</span>
                    <h3 id="kpi-hours">—</h3>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Top Gear Type</span>
                    <h3 id="kpi-gear">—</h3>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Saved Datasets</span>
                    <h3 id="kpi-pending">—</h3>
                </div>
            </div>

            <!-- Main Dashboard Panels (Ready for API integration) -->
            <div class="dashboard-main">
                <div class="panel map-panel">
                    <div class="panel-header">
                        <h3>Map View</h3>
                        <span id="area-status" class="sync-meta">Select an area and click Load Area on Map</span>
                    </div>
                    <div id="map" style="width: 100%; height: 450px; border-radius: 8px;"></div>
                </div>

                <div class="panel form-panel">
                    <h3>Filter Data by Area</h3>
                    <form id="area-filter-form">
                        <label for="area-preset">Preset Area</label>
                        <select id="area-preset">
                            <option value="56.0,-3.0,60.0,2.0">Scottish Waters / North Sea</option>
                            <option value="50.0,-11.0,55.0,-5.0">Irish & Celtic Sea</option>
                            <option value="49.5,-5.5,51.2,1.5">English Channel</option>
                            <option value="VIEWPORT">Use Current Map Viewport</option>
                        </select>

                        <label>Bounding Box (Min/Max Lat & Lng)</label>
                        <div class="split-inputs">
                            <input type="number" step="any" id="min-lat" value="56.0" placeholder="Min Lat" required>
                            <input type="number" step="any" id="min-lng" value="-3.0" placeholder="Min Lng" required>
                        </div>
                        <div class="split-inputs">
                            <input type="number" step="any" id="max-lat" value="60.0" placeholder="Max Lat" required>
                            <input type="number" step="any" id="max-lng" value="2.0" placeholder="Max Lng" required>
                        </div>

                        <label>Date Range</label>
                        <div class="split-inputs">
                            <input type="date" id="start-date" value="2025-09-01" required>
                            <input type="date" id="end-date" value="2025-09-15" required>
                        </div>

                        <label for="spatial-res">Grid Resolution</label>
                        <select id="spatial-res">
                            <option value="LOW">Low (0.1° Grid Cells)</option>
                            <option value="HIGH">High (0.01° Fine Grid Cells)</option>
                        </select>

                        <button type="submit" class="btn-primary">Load Area on Map</button>
                    </form>
                </div>
            </div>

            <!-- Compare fishing activity across two date ranges -->
            <div class="panel compare-panel">
                <div class="panel-header compare-panel-header">
                    <div>
                        <h3>Compare Fishing Activity Over Time</h3>
                        <span id="compare-area-badge" class="sync-meta">Using selected map area (56.0, -3.0 to 60.0, 2.0)</span>
                    </div>
                    <div class="compare-actions">
                        <button type="button" id="plot-period-a-btn" class="tab-btn" disabled>Plot Period A on Map</button>
                        <button type="button" id="plot-period-b-btn" class="tab-btn" disabled>Plot Period B on Map</button>
                        <button type="button" id="export-compare-csv-btn" class="tab-btn" disabled>Export Comparison CSV</button>
                    </div>
                </div>

                <form id="compare-form" class="compare-form">
                    <div class="compare-field">
                        <label for="compare-timeframe">Comparison Window</label>
                        <select id="compare-timeframe">
                            <option value="weekly">Weekly (7 days vs previous 7 days)</option>
                            <option value="monthly" selected>Monthly (30 days vs previous 30 days)</option>
                            <option value="yearly">Yearly (Year-on-Year 30-day window)</option>
                            <option value="custom">Custom Date Ranges</option>
                        </select>
                    </div>

                    <div class="compare-field">
                        <label>Period A (Baseline)</label>
                        <div class="split-inputs">
                            <input type="date" id="compare-a-start" value="2025-07-18" required>
                            <input type="date" id="compare-a-end" value="2025-08-16" required>
                        </div>
                    </div>

                    <div class="compare-field">
                        <label>Period B (Comparison)</label>
                        <div class="split-inputs">
                            <input type="date" id="compare-b-start" value="2025-08-17" required>
                            <input type="date" id="compare-b-end" value="2025-09-15" required>
                        </div>
                    </div>

                    <div class="compare-field">
                        <label for="compare-res">Resolution</label>
                        <div class="split-inputs">
                            <select id="compare-res">
                                <option value="LOW">Low (0.1°)</option>
                                <option value="HIGH">High (0.01°)</option>
                            </select>
                            <button type="submit" class="btn-primary compare-submit-btn">Compare Periods</button>
                        </div>
                    </div>
                </form>

                <p id="compare-status" class="sync-meta" role="status">Choose a timeframe and click Compare Periods.</p>

                <div id="compare-results" class="compare-results hidden">
                    <div class="compare-kpi-grid">
                        <div class="compare-kpi-card">
                            <span class="kpi-label">Total Fishing Hours</span>
                            <div class="compare-kpi-values">
                                <div><small>Period A:</small> <strong id="cmp-hours-a">—</strong></div>
                                <div><small>Period B:</small> <strong id="cmp-hours-b">—</strong></div>
                            </div>
                            <span id="cmp-hours-delta" class="delta-badge flat">—</span>
                        </div>

                        <div class="compare-kpi-card">
                            <span class="kpi-label">Unique Tracked Vessels</span>
                            <div class="compare-kpi-values">
                                <div><small>Period A:</small> <strong id="cmp-vessels-a">—</strong></div>
                                <div><small>Period B:</small> <strong id="cmp-vessels-b">—</strong></div>
                            </div>
                            <span id="cmp-vessels-delta" class="delta-badge flat">—</span>
                        </div>

                        <div class="compare-kpi-card">
                            <span class="kpi-label">Active Grid Cells</span>
                            <div class="compare-kpi-values">
                                <div><small>Period A:</small> <strong id="cmp-cells-a">—</strong></div>
                                <div><small>Period B:</small> <strong id="cmp-cells-b">—</strong></div>
                            </div>
                            <span id="cmp-cells-delta" class="delta-badge flat">—</span>
                        </div>

                        <div class="compare-kpi-card">
                            <span class="kpi-label">Top Gear Type</span>
                            <div class="compare-kpi-values">
                                <div><small>Period A:</small> <strong id="cmp-gear-a">—</strong></div>
                                <div><small>Period B:</small> <strong id="cmp-gear-b">—</strong></div>
                            </div>
                            <span id="cmp-gear-note" class="delta-badge flat">—</span>
                        </div>
                    </div>

                    <div class="compare-visual-grid">
                        <div class="compare-subpanel">
                            <div class="panel-header">
                                <h4>Fishing Hours by Gear Type</h4>
                                <div class="chart-legend">
                                    <span class="legend-item"><span class="legend-dot dot-a"></span>Period A</span>
                                    <span class="legend-item"><span class="legend-dot dot-b"></span>Period B</span>
                                </div>
                            </div>
                            <div id="compare-chart" class="compare-chart"></div>
                        </div>

                        <div class="compare-subpanel">
                            <div class="panel-header">
                                <h4>Detailed Breakdown</h4>
                                <div class="map-tabs">
                                    <button type="button" id="breakdown-gear-tab" class="tab-btn active">By Gear</button>
                                    <button type="button" id="breakdown-flag-tab" class="tab-btn">By Flag</button>
                                </div>
                            </div>
                            <div class="compare-table-wrap">
                                <table class="vessel-table">
                                    <thead>
                                        <tr>
                                            <th id="compare-breakdown-col">Gear Type</th>
                                            <th>Period A (hrs)</th>
                                            <th>Period B (hrs)</th>
                                            <th>Change</th>
                                        </tr>
                                    </thead>
                                    <tbody id="compare-tbody">
                                        <tr>
                                            <td colspan="4" style="opacity: 0.6;">Run a comparison to see breakdown data.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!--vessel search panel -->
            <div class="panel vessel-search-panel">
            <h3>Search vessels</h3>
            <form id="vessel-search-form">
                <label for="vessel-query">Vessel name, IMO, or MMSI</label>
                <input id="vessel-query" name="query" required>
                <button type="submit">Search</button>
            </form>
            <p id="vessel-search-status" role="status"></p>
            <ul id="vessel-results"></ul>
        </div>

            <div class="panel table-panel">
                <div class="panel-header">
                    <h3>Activity Log</h3>


  <button type="button" onclick="downloadCSV()">
            Download CSV
              </button>
                </div>
                <table class="vessel-table">
                    <thead>
                        <tr>
                            <th>Vessel Name</th>
                            <th>MMSI</th>
                            <th>Flag</th>
                            <th>Gear Type</th>
                            <th>Event</th>
                            <th>Hours</th>
                            <th>Coordinates</th>
                        </tr>
                    </thead>
                    <tbody id="vessel-tbody">
                        <tr>
                            <td colspan="7" style="opacity: 0.6;">No data loaded yet.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script src="/scripts/main.js"></script>
        <script src="/scripts/comparison.js"></script>
    </body>
</html>
