<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/style/main.css">
        <title>Fisheries | Dashboard</title>
    </head>
    <body>
        <header>
            <h2>Fisheries Dashboard</h2>
            <div class="header-right">
                <span>Welcome, <strong><%= user %></strong></span>
                <nav>
                    <a href="/logout">Logout</a>
                </nav>
            </div>
        </header>

        <div class="dashboard-content">
            <% if (locals.error_msg) { %>
                <p class="error-msg"><%= error_msg %></p>
            <% } %>
            <% if (locals.success_msg) { %>
                <p class="success-msg"><%= success_msg %></p>
            <% } %>

            <!-- KPI Summary Row -->
            <div class="kpi-grid">
                <div class="kpi-card">
                    <span class="kpi-label">Tracked Vessels</span>
                    <h3 id="kpi-vessels">—</h3>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Total Fishing Hours</span>
                    <h3 id="kpi-hours">—</h3>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Top Gear Type</span>
                    <h3 id="kpi-gear">—</h3>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Saved Datasets</span>
                    <h3 id="kpi-pending">—</h3>
                </div>
            </div>

            <!-- Main Dashboard Panels (Ready for API integration) -->
            <div class="dashboard-main">
                <div class="panel map-panel">
                    <div class="panel-header">
                        <h3>Map View</h3>
                    </div>
                    <div id="map-placeholder" style="width: 100%; height: 450px; border-radius: 8px; background: #151917; display: flex; align-items: center; justify-content: center;">
                        <p style="opacity: 0.6;">Map / API integration placeholder</p>
                    </div>
                </div>

                <div class="panel form-panel">
                    <h3>Filter / Collect Data</h3>
                    <p style="opacity: 0.7;">Controls placeholder for API parameters (Date Range, Area, Resolution).</p>
                </div>
            </div>

            <!--vessel search panel -->
            <div class="panel vessel-search-panel">
            <h3>Search vessels</h3>
            <form id="vessel-search-form">
                <label for="vessel-query">Vessel name, IMO, or MMSI</label>
                <input id="vessel-query" name="query" required>
                <button type="submit">Search</button>
            </form>
            <p id="vessel-search-status" role="status"></p>
            <ul id="vessel-results"></ul>
        </div>

            <div class="panel table-panel">
                <div class="panel-header">
                    <h3>Activity Log</h3>


  <button type="button" onclick="downloadCSV()">
            Download CSV
              </button>
                </div>
                <table class="vessel-table">
                    <thead>
                        <tr>
                            <th>Vessel Name</th>
                            <th>MMSI</th>
                            <th>Flag</th>
                            <th>Gear Type</th>
                            <th>Event</th>
                            <th>Hours</th>
                            <th>Coordinates</th>
                        </tr>
                    </thead>
                    <tbody id="vessel-tbody">
                        <tr>
                            <td colspan="7" style="opacity: 0.6;">No data loaded yet.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <script src="/scripts/main.js"></script>
    </body>
</html>
